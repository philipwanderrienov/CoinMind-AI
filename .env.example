# Database
POSTGRES_DB=coinmind
POSTGRES_USER=coinmind
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=r2dbc:postgresql://localhost:5432/coinmind
PERSISTENCE_ENABLED=false

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=4200

# AI provider
AI_PROVIDER=openai
AI_API_KEY=

# Market data
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
