# Database
POSTGRES_DB=coinmind
POSTGRES_USER=coinmind
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=r2dbc:postgresql://localhost:5432/coinmind
PERSISTENCE_ENABLED=false

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=4200

# AI provider
# ChatGPT Plus/Codex allowance is separate from API billing. Use a dedicated backend API key.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
# Optional task routing. Leave equal to AI_MODEL until you intentionally benchmark another model.
AI_ROUTINE_MODEL=gpt-6-luna
AI_DEEP_MODEL=gpt-6.1-sol
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=400

# Base/routine pricing in micro-USD per 1M tokens.
# Defaults below correspond to GPT-6 Luna standard pricing: $0.10 input, $0.01 cached input, $0.50 output.
AI_INPUT_PRICE_MICROS_PER_MILLION=100000
AI_CACHED_INPUT_PRICE_MICROS_PER_MILLION=10000
AI_OUTPUT_PRICE_MICROS_PER_MILLION=500000

# Override these if routine/deep use different models/prices.
AI_ROUTINE_INPUT_PRICE_MICROS_PER_MILLION=100000
AI_ROUTINE_CACHED_INPUT_PRICE_MICROS_PER_MILLION=10000
AI_ROUTINE_OUTPUT_PRICE_MICROS_PER_MILLION=500000
AI_DEEP_INPUT_PRICE_MICROS_PER_MILLION=2000000
AI_DEEP_CACHED_INPUT_PRICE_MICROS_PER_MILLION=100000
AI_DEEP_OUTPUT_PRICE_MICROS_PER_MILLION=10000000

AI_USAGE_TIMEZONE=Asia/Jakarta

# Development without a paid API key:
# set AI_PROVIDER=mock. Switch back to openai when API credentials are ready.
AI_MIN_AUTOMATIC_SIGNAL_SCORE=45
AI_MAX_AUTOMATIC_CALLS_PER_HOUR=12
AI_MAX_AUTOMATIC_CALLS_PER_DAY=60

# Cost-aware Polymarket AI intelligence.
# Automatic AI calls only occur when deterministic Polymarket data is material.
AI_POLYMARKET_ENABLED=true
AI_POLYMARKET_MIN_PROBABILITY_CHANGE=0.03
AI_POLYMARKET_MIN_IMPORTANCE=80
AI_POLYMARKET_DEEP_MATERIALITY_SCORE=75
AI_POLYMARKET_CACHE_MINUTES=60

# Polymarket upstream resilience
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
PREDICTION_MANIFOLD_BASE_URL=https://api.manifold.markets
POLYMARKET_CONNECT_TIMEOUT_MS=5000
POLYMARKET_RESPONSE_TIMEOUT_MS=8000
POLYMARKET_FAILURE_COOLDOWN_MS=120000
POLYMARKET_GAMMA_EVENT_LIMIT=100
POLYMARKET_CLOB_PAGE_LIMIT=3

# Billing reminder
AI_BILLING_REMINDER_ENABLED=false
AI_BILLING_PROVIDER=OPENAI
AI_BILLING_DUE_DAY=1
AI_BILLING_REMINDER_DAYS=2
AI_BILLING_TIMEZONE=Asia/Jakarta
AI_BILLING_CRON=0 0 9 * * *

# Browser Web Push
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Market data
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
HISTORICAL_CANDLE_LIMIT=500

# News
NEWS_ENABLED=false
NEWS_REFRESH_INTERVAL_MS=300000

NEWS_RETENTION_ENABLED=true
NEWS_HOT_RETENTION_DAYS=30
NEWS_ARCHIVE_RETENTION_DAYS=365
NEWS_RETENTION_CRON=0 15 3 * * *

NEWS_RSS_COINDESK=https://www.coindesk.com/arc/outboundfeeds/rss/
NEWS_RSS_COINTELEGRAPH=https://cointelegraph.com/rss
